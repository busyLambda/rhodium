# std/collections/List - already inside the prelude
type List[T] = { # Record
  capacity u32
  length   u32
  head     *T
} where {
  # An associated item: its first parameter is the receiver.
  head = fn(list List[T]) Maybe[T] -> match list # Can decouple list because List has contract signed: SeqPattern -> syntax sugar for calling it's fucntions
  | [x:...] -> Something(x)
  | _       -> Nothing
}
